{
  "name": "figma-real-layout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:api && vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "node server-dist/index.js",
    "test:api": "tsx --test server/tests/auth.test.ts server/tests/promocodes.test.ts server/tests/payments.test.ts server/tests/account-state.test.ts server/tests/game-entitlements.test.ts server/tests/mailer-mime.test.ts",
    "promo:create": "tsx server/scripts/promocodes.ts create",
    "promo:stats": "tsx server/scripts/promocodes.ts stats",
    "qa:auth": "node scripts/qa_auth_backend.cjs",
    "qa:home-header": "node scripts/qa-home-header.cjs",
    "qa:profile-edit-icon": "node scripts/qa-profile-edit-icon.cjs",
    "qa:music-attention": "node scripts/qa-music-attention-image.cjs",
    "qa": "node scripts/capture-new-pages.cjs",
    "qa:figma-flow": "node scripts/capture-new-pages.cjs",
    "qa:layout5-auth": "node scripts/qa-layout5-auth-exact.cjs",
    "qa:layout5-extra": "node scripts/qa-layout5-extra.cjs",
    "qa:layout5-game": "node scripts/qa-layout5-game.cjs",
    "qa:layout5-purchase": "node scripts/qa-layout5-purchase.cjs",
    "qa:game-isolation": "node scripts/qa-karaoke-routing.cjs",
    "qa:layout6-collection": "node scripts/qa-layout6-collection.cjs",
    "qa:layout6-purchase": "node scripts/qa-layout6-purchase.cjs",
    "qa:layout6-screens": "node scripts/qa-layout6-screens.cjs",
    "qa:layout7": "node scripts/qa-layout7.cjs",
    "qa:karaoke-media": "node scripts/qa-karaoke-media.cjs",
    "qa:karaoke-preview": "node scripts/qa-karaoke-preview-link.cjs",
    "qa:legacy": "node scripts/qa-browser.cjs",
    "qa:clips": "node scripts/capture-page-clips.cjs",
    "figma:screenshots": "node scripts/fetch-figma-screenshots.cjs",
    "favicon:generate": "node scripts/generate-favicon.cjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.12.5",
    "jszip": "^3.10.1",
    "nodemailer": "^10.0.15",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^10.0.4",
    "playwright": "^1.62.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.1.3"
  }
}
