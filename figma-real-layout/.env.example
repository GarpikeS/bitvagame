NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173

# Минимум 32 случайных символа. В production без этого сервер не запустится.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_DATA_FILE=server-data/auth.json
SESSION_DAYS=30
CODE_LIFETIME_MINUTES=10
CODE_COOLDOWN_SECONDS=60
MAX_CODE_ATTEMPTS=5
MAX_EMAILS_PER_HOUR=5
# Временный режим без отправки письма: фиксированный код только для регистрации.
AUTH_FIXED_REGISTRATION_CODE=

# Секрет для административного API промокодов. Не публиковать во frontend.
PROMO_ADMIN_TOKEN=replace-with-a-second-long-random-secret

# Основной вариант: SMTP Яндекса. Пароль приложения хранить только в .env сервера.
EMAIL_FROM="Битва Игры <support@muzlotodoma.ru>"
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@muzlotodoma.ru
SMTP_PASSWORD=

# Резервный вариант: Resend. Используется, только если SMTP не настроен.
# Создать ключ: https://resend.com/api-keys
RESEND_API_KEY=

# Интернет-эквайринг Точки. JWT и merchantId хранятся только на сервере.
TOCHKA_API_BASE_URL=https://enter.tochka.com/uapi
TOCHKA_JWT_TOKEN=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_PAYMENT_MODES=card,sbp
TOCHKA_RETURN_URL=https://example.ru/#/balance-top-up
TOCHKA_FAIL_RETURN_URL=https://example.ru/#/balance-top-up
